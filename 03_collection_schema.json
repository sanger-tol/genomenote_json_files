{
    "$schema": "https://json-schema.org/draft/2020-12/schema#",
    "type": "object",
    "source": [
        "STS"
    ],
    "properties": {
        "sample_accession": {
            "type": "string",
            "help": "BioSample accession for the sample used for this workflow role.",
            "required": true
        },
        "sample_derived_from": {
            "type": "string",
            "help": "Source individual or parent BioSample accession, where different from sample_accession."
        },
        "tolid": {
            "type": "string",
            "recommended": true
        },
        "specimen_id": {
            "type": "string"
        },
        "organism_part": {
            "type": "string",
            "required": true
        },
        "collection_protocol": {
            "type": "array",
            "help": "Protocols used for the collection of the assembly set. Should be listed in the references.",
            "items": {
                "$ref": "_protocol_schema.json#/$defs/protocol"
            }
        },
        "preservation_data": {
            "type": "array",
            "properties": {
                "sample_id": "string",
                "method": {
                    "type": "string",
                    "help": "Method of preservation used",
                    "required": true
                },
                "solution": {
                    "type": "string",
                    "help": "Storage solution"
                }
            }
        },
        "identification_data": {
            "type": "array",
            "properties": {
                "sample_id": "string",
                "scientific_name": "string",
                "method": {
                    "type": "string",
                    "help": "How was the organism identified?"
                },
                "sex": {
                    "type": "string"
                },
                "lifestage": {
                    "type": "string"
                },
                "required": ["sample_id", "scientific_name", "sex", "lifestage"]
            }
        },
        "collection_data": {
            "type": "array",
            "properties": {
                "museum_voucher_id": {
                    "type": "string",
                    "help": "Museum Voucher ID, if Not available, NA"
                },
                "sample_id": "string",
                "method": {
                    "type": "string",
                    "help": "How was the sample collected"
                },
                "date": {
                    "type": "string",
                    "help": "Date of collection",
                    "recommended": true
                },
                "location": {
                    "help": "Name of town/city/region",
                    "type": "string"
                },
                "country": {
                    "help": "Country of Origin",
                    "type": "string"
                },
                "latitude": {
                    "type": "number",
                    "recommended": true
                },
                "longitude": {
                    "type": "number",
                    "recommended": true
                },
                "elevation": {
                    "type": "number",
                    "help": "Elevation the sample was collected at, in metres",
                    "recommended": true
                },
                "required": ["museum_voucher_id", "location", "country", "method"]
            }
        },
        "involved_persons": {
            "type": "array",
            "source": [
                "AuthorsDB"
            ],
            "items": {
                "$ref": "_author_schema.json#/$defs/author"
            }
        },
        "specimen_images": {
            "type": "array",
            "help": "Images of the collected specimen or source individual used in the genome note.",
            "recommended": true,
            "items": {
                "type": "object",
                "properties": {
                    "image": {
                        "type": "string"
                    },
                    "link": {
                        "type": "string"
                    },
                    "caption": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
