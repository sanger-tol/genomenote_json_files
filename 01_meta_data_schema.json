{
    "$schema": "https://json-schema.org/draft/2020-12/schema#",
    "type": "object",
    "source": [
        "tolqc",
        "STS"
    ],
    "properties": {
        "metadata": {
            "type": "object",
            "properties": {
                "template_version": {
                    "type": "string"
                },
                "doi": {
                    "type": "string",
                    "help": "DOI, without the https://doi.org/ prefix, example is: 10.1080/10509585.2015.1092083",
                    "pattern": "^10\\.\\d{4,9}/\\S+$"
                },
                "data_availability": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "abstract": {
                    "type": "string",
                    "help": "Markdown is fine"
                },
                "keywords": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "background": {
                    "type": "string"
                },
                "bioproject": {
                    "type": "string",
                    "help": "Umbrella BioProject in INSDC containing all sequencing data, genome assembly/assemblies and links to relevant BioSample information."
                },
                "child_bioprojects": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "help": "Child BioProjects associated with the main BioProject; used to ID sequencing run metadata.",
                    "recommended": true

                },
                "parent_projects": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "accession": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "project_name": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            }
                        }
                    },
                    "help": "Parent (i.e. Project-level) BioProjects associated with the main BioProject. Used to derive formatted_parent_projects.",
                    "recommended": true
                },
                "formatted_parent_projects": {
                    "type": "string",
                    "help": "Publication-ready parent project string derived from parent_projects by data_note. Describes, e.g. Project Psyche.",
                    "recommended": true
                },
                "authors": {
                    "type": "array",
                    "source": [
                        "AuthorsDB",
                        "AllJson"
                    ],
                    "items": {
                        "$ref": "_author_schema.json#/$defs/author"
                    }
                },
                "affiliations": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "affiliation": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "required": [
                "doi",
                "title",
                "bioproject",
                "authors",
                "affiliations",
                "data_availability",
                "child_bioprojects",
                "parent_projects",
                "formatted_parent_projects"
            ]
        },
        "publication_metadata": {
            "type": "object",
            "source": [
                "AuthorsDB"
            ],
            "properties": {
                "funding": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "source": {
                                "type": "string"
                            },
                            "award_ids": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "funding_statement": {
                                "type": "string"
                            }
                        }
                    }
                },
                "journal_data": {
                    "type": "array",
                    "properties": {
                        "journal_name": "string",
                        "e_location_id": "string",
                        "license": "string",
                        "submission_date": "string",
                        "publication_date": "string"
                    },
                    "help": "If a genome note already exists for this assembly or set of assemblies in another publication platform/journal, place a link here"
                },
                "genome_note_data": {
                    "existing_genome_note": {
                        "type": "string",
                        "help": "Link to an existing genome note, if this is not a v1 genome note"
                    },
                    "submission_date": "string",
                    "publication_date": "string"
                },
                "ebp_analysis_metrics": {
                    "type": "array"
                },
                "acknowledgements": {
                    "type": "string",
                    "recommended": true
                },
                "ethics_and_consent": {
                    "type": "string",
                    "help": "Where necessary, please detail any ethical or legal permits that were acquired in order to carry out the steps to generate this genome report. If not applicaable, please put N/A"
                },
                "competing_interests": {
                    "type": "string",
                    "help": "Please details any conflicting interests. If not applicable, please put N/A"
                }
            },
            "required": [
                "journal_data",
                "genome_note_data",
                "ebp_analysis_metrics",
                "ethics_and_consent",
                "competing_interests"
            ]
        }
    },
    "required": [
        "metadata",
        "publication_metadata"
    ]
}
